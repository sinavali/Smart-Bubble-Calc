name: Enterprise Monorepo CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  mechanical-gates:
    name: Mechanical Governance Gates
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Verify Nx Project Target Contracts
        run: python3 scripts/verify-nx-targets.py --root .

      - name: Lint AGENT.md Manifests & Tier Overrides
        run: python3 scripts/verify-agent-manifests.py --root .

      - name: Check Open NC Items for 14-Day Expiration
        run: python3 scripts/check-nc-items.py --dir docs/nc --max-age 14

      - name: Validate PR Change Surface
        if: github.event_name == 'pull_request'
        run: python3 scripts/validate-change-surface.py CHANGE_SURFACE.md

  monorepo-pipeline:
    name: Monorepo Target Matrix
    runs-on: ubuntu-latest
    needs: [mechanical-gates]
    steps:
      - name: Checkout Source
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: "1.23"
          cache-dependency-path: backend/go.mod

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Monorepo Lint (All Targets)
        run: python3 scripts/ep.py run-many --target=lint

      - name: Monorepo Test (All Targets)
        run: python3 scripts/ep.py run-many --target=test

      - name: Monorepo Build (All Targets)
        run: python3 scripts/ep.py run-many --target=build

      - name: Monorepo Audit (All Targets)
        run: python3 scripts/ep.py run-many --target=audit

  gatekeeper-verdict:
    name: Enterprise Gatekeeper Verdict
    runs-on: ubuntu-latest
    needs: [mechanical-gates, monorepo-pipeline]
    if: always()
    steps:
      - name: Evaluate Pipeline Status
        run: |
          if [ "${{ needs.mechanical-gates.result }}" != "success" ] || [ "${{ needs.monorepo-pipeline.result }}" != "success" ]; then
            echo "::error ::Enterprise Gatekeeper checks failed. Pull request cannot be merged."
            exit 1
          fi
          echo "All enterprise mechanical gates and subproject targets succeeded."
